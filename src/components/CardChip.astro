---
import type { Card } from '../lib/schema.ts';
import { palette } from '../lib/chart.ts';

interface Props {
  card: Card;
  size?: 'sm' | 'md';
}

const { card, size = 'md' } = Astro.props;
const p = palette(card.color);
---

<!--
  Identificazione tipografica della carta: nessun asset grafico American Express,
  solo testo e colore. Il colore fa il riconoscimento a colpo d'occhio, il nome
  fa l'identificazione: e' l'uso nominativo del marchio, non la riproduzione.
-->
<span
  class:list={['card-chip', size === 'sm' && 'card-chip-sm']}
  style={`--chip: ${p.chip}; --chip-dark: ${p.chipDark};`}
>
  <span class="card-chip-bar" aria-hidden="true"></span>
  <span class="card-chip-name">{card.name}</span>
</span>
