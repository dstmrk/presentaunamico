---
import { periods } from '../lib/promotions.ts';

/**
 * Le fonti distinte dell'archivio, in una riga sola.
 *
 * Stavano in una colonna della tavola, ripetute su ogni riga: mezza larghezza
 * della tabella per un'informazione che cambia tre volte in tutto. E stanno qui
 * e non dentro HistoryTable perche' `source` e' del PERIODO, non della carta:
 * l'elenco e' identico per tutte e undici le tavole, e in home sarebbe stato
 * ripetuto undici volte uguale.
 *
 * Il dettaglio periodo per periodo, note comprese, resta in promotions.json.
 */

/** Etichetta breve: il lettore deve capire quanto fidarsi, non da dove viene l'URL. */
function sourceLabel(url: string | undefined): string {
  if (!url) return 'rilevazione indiretta';
  const host = new URL(url).hostname.replace(/^www\./, '');
  if (host.endsWith('americanexpress.com')) return 'condizioni ufficiali';
  if (host.includes('finanzaonline')) return 'forum specializzato';
  return 'archivio pubblico';
}

// Dal periodo piu' recente al piu' vecchio: ogni fonte porta il link
// all'occorrenza piu' recente in cui e' stata usata.
const sources: { label: string; url?: string }[] = [];
for (let i = periods.length - 1; i >= 0; i--) {
  const { source } = periods[i]!;
  const label = sourceLabel(source.url);
  if (!sources.some((s) => s.label === label)) sources.push({ label, url: source.url });
}
---

<p class="table-sources">
  Fonti:{' '}
  {sources.map((source, i) => (
    <>
      {i > 0 && <span aria-hidden="true"> · </span>}
      {source.url ? (
        <a href={source.url} rel="nofollow noopener" target="_blank">{source.label}</a>
      ) : (
        source.label
      )}
    </>
  ))}
</p>
