# Cloudflare Pages: gli header qui dentro fanno matching sul PATH, non sull'host.
# Il noindex per *.pages.dev NON puo' stare qui (verrebbe servito anche sul
# dominio custom): vive in functions/_middleware.ts, che vede l'header Host.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
